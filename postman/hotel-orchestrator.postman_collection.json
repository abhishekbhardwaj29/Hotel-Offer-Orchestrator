{
  "info": {
    "name": "Hotel Orchestrator API",
    "description": "Collection for testing the Hotel Offer Orchestrator service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Hotels",
      "item": [
        {
          "name": "Get hotels for Delhi (with overlaps)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [
                { "key": "city", "value": "delhi" }
              ]
            },
            "description": "Fetches deduplicated hotel offers for Delhi. Supplier A and B both list Holtin, Radison, and Lemon Tree — expect the cheaper option for each."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is an array', function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Contains deduplicated hotels', function () {",
                  "    var body = pm.response.json();",
                  "    var names = body.map(function(h) { return h.name; });",
                  "    // Should have unique names only",
                  "    var unique = [...new Set(names)];",
                  "    pm.expect(names.length).to.equal(unique.length);",
                  "});",
                  "",
                  "pm.test('Holtin picked from cheaper supplier', function () {",
                  "    var body = pm.response.json();",
                  "    var holtin = body.find(function(h) { return h.name === 'Holtin'; });",
                  "    pm.expect(holtin).to.not.be.undefined;",
                  "    pm.expect(holtin.price).to.equal(5340);",
                  "    pm.expect(holtin.supplier).to.equal('Supplier B');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get hotels for Delhi — price filter (4000–6000)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi&minPrice=4000&maxPrice=6000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [
                { "key": "city", "value": "delhi" },
                { "key": "minPrice", "value": "4000" },
                { "key": "maxPrice", "value": "6000" }
              ]
            },
            "description": "Returns only hotels priced between 4000 and 6000. Uses Redis sorted-set filtering."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('All prices within range', function () {",
                  "    var body = pm.response.json();",
                  "    body.forEach(function(h) {",
                  "        pm.expect(h.price).to.be.at.least(4000);",
                  "        pm.expect(h.price).to.be.at.most(6000);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get hotels for Mumbai",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=mumbai",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [
                { "key": "city", "value": "mumbai" }
              ]
            },
            "description": "Fetches deduplicated hotel offers for Mumbai."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is an array', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "City with no results",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=patna",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"],
              "query": [
                { "key": "city", "value": "patna" }
              ]
            },
            "description": "Neither supplier has hotels in Patna — expect an empty array."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Empty array returned', function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body).to.be.an('array').that.is.empty;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Missing city parameter",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotels"]
            },
            "description": "No city query param — should return 400."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test('Error message present', function () {",
                  "    pm.expect(pm.response.json().error).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
