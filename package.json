{
  "name": "hotel-orchestrator",
  "version": "1.0.0",
  "description": "Hotel offer aggregation and orchestration service using Temporal, Redis, and Express",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "dev": "ts-node src/server.ts",
    "dev:worker": "ts-node src/worker.ts"
  },
  "dependencies": {
    "@temporalio/activity": "^1.11.7",
    "@temporalio/client": "^1.11.7",
    "@temporalio/worker": "^1.11.7",
    "@temporalio/workflow": "^1.11.7",
    "express": "^4.21.0",
    "ioredis": "^5.4.1",
    "uuid": "^10.0.0",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.4",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.5.4"
  }
}
